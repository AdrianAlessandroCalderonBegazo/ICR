# Copiar a .env y completar antes de `docker compose up`.

# Contraseña del usuario de PostgreSQL de este módulo (icr_cms_app).
DB_PASSWORD=

# Secreto para firmar los JWT del panel de administración. Generar uno
# aleatorio, por ejemplo: openssl rand -base64 48
JWT_SECRET=

# Dominio del sitio público (icr-frontend-design1) — el backend solo acepta
# peticiones a /api/proyectos desde este origen.
SITE_DOMAIN=inversionesicr.com

# Subdominio donde queda expuesto este panel (backend + admin estático).
CMS_DOMAIN=cms.inversionesicr.com
